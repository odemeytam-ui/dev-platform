# EditorConfig helps maintain consistent formatting across editors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,html}]
indent_size = 2

[Makefile]
indent_style = tab

[*.py]
indent_size = 4

[*.tf]
indent_size = 2

[*.sh]
indent_size = 2